# Autentikasi MagangHub API (isi minimal salah satu sesuai request header di DevTools)
# 1. Jika memakai Authorization: Bearer <token>, isi token tanpa prefix "Bearer "
MAGANGHUB_AUTH_TOKEN=
# 2. Jika memakai Cookie header, paste nilai Cookie dari DevTools
MAGANGHUB_COOKIE=

# Konfigurasi Gmail SMTP (gunakan App Password Google, bukan password akun utama)
GMAIL_USER=dianrestuadji@gmail.com
GMAIL_APP_PASSWORD=
# Opsional: alamat tujuan email pengingat (default sama dengan GMAIL_USER)
REMINDER_TO_EMAIL=

# Opsional: tanggal merah / cuti tambahan dipisahkan koma (format YYYY-MM-DD)
EXTRA_HOLIDAYS=

# Opsional: zona waktu evaluasi tanggal (default Asia/Jakarta)
TIMEZONE=Asia/Jakarta
