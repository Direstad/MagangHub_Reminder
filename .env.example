# Konfigurasi Gmail SMTP (gunakan App Password Google, bukan password akun utama)
GMAIL_USER=dianrestuadji@gmail.com
GMAIL_APP_PASSWORD=

# Opsional: alamat tujuan email pengingat (default sama dengan GMAIL_USER)
REMINDER_TO_EMAIL=

# Opsional: nama peserta untuk sapaan email
PARTICIPANT_NAME=Dian Restu Adji

# Opsional: hari libur mingguan dipisahkan koma (default SUNDAY)
OFF_DAYS=SUNDAY

# Opsional: tanggal merah / cuti tambahan dipisahkan koma (format YYYY-MM-DD)
EXTRA_HOLIDAYS=

# Opsional: rentang periode magang agar pengingat otomatis berhenti saat selesai
INTERNSHIP_START_DATE=2026-08-10
INTERNSHIP_END_DATE=2027-02-09

# Opsional: zona waktu evaluasi tanggal (default Asia/Jakarta)
TIMEZONE=Asia/Jakarta
